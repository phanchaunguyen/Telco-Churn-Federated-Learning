# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual envs ---
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Data (never commit) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# --- Experiment outputs ---
# Large per-run dumps stay out of git; the small report-ready summaries
# (E*.json, E*.csv, E*.md, *_metadata.json, *_verification.json) are tracked
# because the report cites them directly.
results/*
!results/.gitkeep
!results/E*.json
!results/E*.csv
!results/E*.md
!results/*_metadata.json
!results/*_verification.json
!results/spark_benchmark.csv
!results/eda_*.csv
results/runs/
mlruns/
mlartifacts/
mlflow.db

# --- Model checkpoints ---
*.pt
*.pth
*.ckpt
*.onnx

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- pytest ---
.pytest_cache/

# --- Spark jars (downloaded, not source) ---
jars/*.jar
